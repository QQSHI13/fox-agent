{
  "name": "foxc",
  "version": "0.1.0",
  "description": "foxc - a light coding harness with agent-controlled context",
  "type": "module",
  "bin": {
    "foxc": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun --preload @opentui/solid/preload src/cli.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "bun-types": "^1.4.0"
  },
  "dependencies": {
    "@opentui/core": "^0.5.6",
    "@opentui/solid": "^0.5.6",
    "clipboardy": "^5.3.2",
    "solid-js": "^1.9.15"
  }
}