{
  "name": "fox-agent",
  "version": "0.7.0",
  "description": "fox-agent - a light coding harness with agent-controlled context",
  "type": "module",
  "bin": {
    "fox": "./src/cli.ts",
    "fox-agent": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/sdk.ts",
    "./sdk": "./src/sdk.ts"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "bun check --no-pretty",
    "verify": "bun run typecheck && bun test",
    "check:tui": "bun run typecheck && bun test test/term.test.ts test/screen.test.ts test/layout.test.ts test/wrap-input.test.ts test/markdown.test.ts test/rich.test.ts test/toolhead.test.ts test/difftouch.test.ts",
    "check:acp": "bun run typecheck && bun test test/acp.test.ts",
    "check:fast": "bun run typecheck && bun test --timeout 30000",
    "lint": "bun check --no-pretty",
    "size": "find src -name '*.ts' | xargs wc -l | sort -rn | head -15",
    "acp-accept": "bun run build && bun scripts/acp-accept.ts",
    "bench": "bun run build && python3 scripts/bench/bench.py"
  },
  "devDependencies": {
    "bun-types": "1.4.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/google": "4.0.107",
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@speed-highlight/core": "2.1.0",
    "ai": "7.0.156"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QQSHI13/fox-agent.git"
  },
  "bugs": {
    "url": "https://github.com/QQSHI13/fox-agent/issues"
  },
  "homepage": "https://github.com/QQSHI13/fox-agent#readme",
  "keywords": [
    "ai",
    "coding-agent",
    "tui",
    "acp",
    "mcp",
    "bun"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "src",
    "build.ts",
    "README.md",
    "LICENSE"
  ]
}
