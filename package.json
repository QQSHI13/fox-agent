{
  "name": "fox-agent",
  "version": "0.5.0-beta.1",
  "description": "fox-agent - a light coding harness with agent-controlled context",
  "type": "module",
  "bin": {
    "fox": "./src/cli.ts",
    "fox-agent": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/sdk.ts",
    "./sdk": "./src/sdk.ts"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun run build && python3 scripts/bench/bench.py"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.1",
    "@ai-sdk/anthropic": "^4.0.69",
    "@ai-sdk/google": "^4.0.86",
    "@ai-sdk/openai": "^4.0.82",
    "@ai-sdk/openai-compatible": "^3.0.60",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ai": "^7.0.123",
    "smol-toml": "^1.9.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QQSHI13/fox-agent.git"
  },
  "bugs": {
    "url": "https://github.com/QQSHI13/fox-agent/issues"
  },
  "homepage": "https://github.com/QQSHI13/fox-agent#readme",
  "keywords": [
    "ai",
    "coding-agent",
    "tui",
    "acp",
    "mcp",
    "bun"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "files": [
    "src",
    "build.ts",
    "README.md",
    "LICENSE"
  ]
}
